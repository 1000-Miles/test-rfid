# --- Bridge server ---
PORT=3001

# --- Reader defaults (can be overridden per /connect request) ---
UR4_IP=192.168.99.202
UR4_PORT=8888

# Software read-zone floor, in dBm (negative; closer to zero = stronger).
# Any read weaker than this is dropped in the controller, so it never becomes
# a tag event, a board row, a movement, or a database row. Blank = keep every
# read. -70..-55 is the usual range for a doorway; tune it against the RSSI
# column in the console's tag feed. Settable live: POST /read-filter {minRssi}.
# Set it too close to zero and the carton actually passing gets dropped too.
# READ_MIN_RSSI=-65

# --- Chainway CP30 printer defaults (also configurable live via /printer/config) ---
# PRINTER_TRANSPORT=usb            # usb (Windows queue, RAW) | tcp (raw port 9100)
# PRINTER_NAME=Chainway CP30       # Windows print queue name (usb transport)
# PRINTER_HOST=192.168.99.201      # printer IP (tcp transport)
# PRINTER_TCP_PORT=9100

# Permanent identity of THIS gate — the gateId half of every movement's
# immutable event id (gateId:seq). Defaults to NEXUS_LOCATION; REQUIRED to be
# unique per gate the day a second doorway gets a bridge.
# GATE_ID=yiwu-main-gate

# --- Nexus forwarding (warehouse inventory system) ---
# If NEXUS_URL is set, every movement event (entry/exit) is POSTed there as
# JSON (fire-and-forget). Leave blank to run the built-in mock Nexus only.
# GATE_SHORT=G1                    # short gate code inside every pallet code
#                                  # (PALLET-G1-001). MUST be unique per gate —
#                                  # two gates sharing it mint identical pallet
#                                  # codes and merge pallets in Nexus.

NEXUS_URL=
NEXUS_BATCH_URL=
MOVEMENT_BATCH_SETTLE_MS=500
MOVEMENT_TOGGLE_BATCH_QUIET_MS=1500
# How long a pallet stays open. Everything read inside the window lands on ONE
# pallet code and ONE printed label, so with no beams this is the only thing
# separating one pallet from the next. Pressing "Close & print" ends it early;
# this is the fallback for when nobody does. Also settable live from the console
# (No-IR tuning), and that setting STICKS across restarts — data/pallet-window.json
# wins over this line, which is only the default for a gate never set by hand.
# Longer windows group more onto one pallet; too long merges pallets arriving
# back to back, too short splits a slow unload across two labels.
MOVEMENT_TOGGLE_PALLET_WINDOW_MS=120000

# Auth for the gated Nexus API. Get a machine-to-machine key from the Nexus
# admin/team — the bridge can't obtain one on its own.
# NEXUS_API_KEY=                   # sent as "Authorization: Bearer <key>"
# NEXUS_AUTH_HEADER=               # OR raw header for other schemes, e.g. "X-Api-Key: abc123"

# Portal decision tuning (defaults shown; all optional)
# Direction comes from the two IR beams: GPI1 broken first = IN,
# GPI2 broken first = OUT (wired into the controller, not configurable here).
# NEXUS_DEDUP_MS=5000              # ignore an EPC for this long after a movement event
# NEXUS_QUIET_MS=700               # decision fires after this much silence for an EPC
# NEXUS_MAX_WINDOW_MS=4000         # hard cap: decide at latest this long after first read
# NEXUS_LOCATION=WH-ENTRANCE-1     # location tag stamped on every event

# NO-IR trial mode ("toggle") — antennas facing each other, no IR beams.
# Direction is INFERRED (first pass = received/IN, next pass = ship/OUT,
# anchored to Nexus carton state), not observed. Switchable live from the
# engineering console's "No-IR trial" tab; these only set the boot defaults.
# NEXUS_DETECT_MODE=ir             # ir (beams, default) | toggle (no-IR trial)
# NEXUS_TOGGLE_DEDUP_MS=60000      # re-arm: same EPC can't fire again for this long.
#                                  # Keep well above the RF discovery tail (reads trail
#                                  # a passage by 10-20s). Raise a lot for production.
# NEXUS_ABSENCE_MS=30000           # a new visit opens only after the tag was UNSEEN
#                                  # this long — the no-IR substitute for "beams cleared"
# NEXUS_MIN_RSSI=                  # extra dBm floor applied ONLY to NO-IR toggle
#                                  # decisions. For a floor that covers every mode,
#                                  # use READ_MIN_RSSI above; the two stack.
# NEXUS_TOGGLE_MIN_READS=1         # 1 = a single read counts (default). >1 drops
#                                  # quieter visits as noise — it loses real cartons,
#                                  # so raise it only with evidence of ghost reads.
# NEXUS_TOGGLE_FAST_COUNT=         # blank/0 (default) = every carton is held for the
#                                  # decision window (NEXUS_QUIET_MS / MAX_WINDOW_MS)
#                                  # before it reaches the board. Because the reader runs
#                                  # CONTINUOUSLY in no-IR mode, a pallet standing in the
#                                  # field re-arms that timer, so each carton fires at its
#                                  # own max-window and they trickle onto the board one at
#                                  # a time. 1 = count the moment MIN_READS is satisfied,
#                                  # which in no-IR mode is all the reads decide (direction
#                                  # is inferred, not read). Costs telemetry, not accuracy:
#                                  # the receipt then carries the deciding read(s), so its
#                                  # read count, antenna list and strongest RSSI narrow.
# PALLET_AUTOPRINT=              # blank/0 (default) = a pallet tag prints only when
#                                  # someone presses Print on the pallet card. 1 = print
#                                  # automatically as soon as an inbound pallet settles.
#                                  # Only turn this on where the read zone is tight enough
#                                  # that a stray tag cannot open a pallet by itself — in
#                                  # NO-IR mode a read IS a movement (see NEXUS_MIN_RSSI).

# Wire format for palletCode. short = PALLET-G1-001 (readable on a label and
# over a radio); long = PLT-YIWU-MAIN-GATE-00000526 (the default).
#
# DO NOT set this to short until Nexus accepts the pattern. Nexus validates
# palletCode and answers 400 for the short form, and because a 400 is terminal
# every carton carrying one is dead-lettered — read by the gate, counted on the
# board, refused by the server. See NEXUS-HANDOFF.md item 3.
# PALLET_CODE_FORMAT=long

# Reset marker (Option A): the gate ASKS Nexus whether a receiving reset has
# happened, every NEXUS_RESET_POLL_MS. Needed because Nexus is on the internet
# and this bridge is on the warehouse LAN — nothing can call inward, but the
# gate can always call out. Nexus must answer this URL with:
#   { "resetAt": "2026-08-24T06:32:11.000Z",   // or "resetSeq": 47
#     "epcs": ["E280...", ...],                 // cartons the reset undid
#     "reason": "batch 4821 reset on iPad" }    // optional, for the log
# resetAt is compared for equality only, never parsed as a date — a counter or
# row id works just as well. Sending `epcs` is what makes the reset surgical;
# without it the gate has to forget every carton it knows.
# Authenticated with NEXUS_API_KEY as a bearer token (same key as the push).
# NEXUS_RESET_URL=https://nexus.1000miles.site/api/receiving/reset-marker
# NEXUS_RESET_POLL_MS=5000

# Key Nexus must send as "Authorization: Bearer <key>" when it calls
# POST /receiving/reset. Defaults to MOVEMENT_API_KEY / NEXUS_API_KEY — the key
# Nexus already holds — so normally there is nothing new to distribute. Unset
# and with no movement key either, the webhook is open to anything on this LAN.
# RESET_WEBHOOK_KEY=

# BOARD_REFRESH_MS=60000          # how often the bridge re-reads today's receiving batches
#                                  # on its own clock. This is what lets the gate judge an
#                                  # arriving carton ("is there an open batch for it?") without
#                                  # depending on a kiosk being open to poll. 0 = off, which
#                                  # leaves the check passing everything on a TV-only doorway.
# NEXUS_CATALOG_REFRESH_MS=60000   # was 120000. This is how the gate learns a
#                                  # carton was withdrawn when the reset did not name
#                                  # it, so the interval is the worst-case delay before
#                                  # a redo is possible — and a window in which an
#                                  # already-counted carton can be counted again. A
#                                  # reset now also triggers this read immediately.  # how often the tag registry + carton state is re-read.
#                                  # This is what keeps the outbound check honest: an exit is
#                                  # only flagged as unexpected while the carton state behind
#                                  # it is fresh (30 min), so a longer interval here means
#                                  # more passages go unchecked, not more false alarms. 0 = off.

# --- Optional Supabase forwarding ---
# If SUPABASE_URL and SUPABASE_ANON_KEY are both set, each tag read is POSTed
# to the REST table below. Leave blank to disable forwarding.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_TABLE=rfid_reads
